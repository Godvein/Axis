@model Axis.Models.ViewModels.AdminDashboardInfoViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="mb-4">
        <h2>Dashboard</h2>

        <p class="text-muted">
            Welcome back,
            <strong>@Context.Session.GetString("Username")</strong>
        </p>
    </div>


    <!-- Statistics -->
    <div class="row g-3">

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Users</h6>
                    <h2>@Model.AdminDashboardInfo.UsersCount</h2>
                    <small>Total Registered</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Tasks</h6>
                    <h2>@Model.AdminDashboardInfo.TasksCount</h2>
                    <small>Total Tasks</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Roles</h6>
                    <h2>@Model.AdminDashboardInfo.RolesCount</h2>
                    <small>System Roles</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h6 class="text-muted">Departments</h6>
                    <h2>@Model.AdminDashboardInfo.DepartmentsCount</h2>
                    <small>Available</small>
                </div>
            </div>
        </div>

    </div>


    <!-- Quick Actions -->
    <div class="mt-5">

        <h4>Quick Actions</h4>

        <div class="d-flex flex-wrap gap-2 mt-3">

            <a asp-controller="Admin"
               asp-action="Users"
               class="btn btn-primary">
                Manage Users
            </a>

            <a asp-controller="Admin"
               asp-action="Tasks"
               class="btn btn-success">
                Manage Tasks
            </a>

            <a asp-controller="Admin"
               asp-action="Roles"
               class="btn btn-warning">
                Manage Roles
            </a>

            <a asp-controller="Report"
               asp-action="Index"
               class="btn btn-secondary">
                Reports
            </a>

        </div>

    </div>


    <!-- Recent Activity -->
    <div class="card shadow-sm mt-5">

        <div class="card-header">
            <h5 class="mb-0">Recent Activity</h5>
        </div>

        <div class="card-body p-0">

            @if (Model.RecentActivities != null &&
                 Model.RecentActivities.Any())
            {
                <table class="table table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>User</th>
                            <th>Activity</th>
                            <th>Type</th>
                            <th>Date</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var activity in Model.RecentActivities)
                        {
                            <tr>

                                <td>
                                    @activity.Username
                                </td>

                                <td>
                                    @activity.Activity
                                </td>

                                <td>
                                    @if (activity.ActivityType == "Task")
                                    {
                                        <span class="badge bg-success">
                                            Task
                                        </span>
                                    }
                                    else if (activity.ActivityType == "User")
                                    {
                                        <span class="badge bg-primary">
                                            User
                                        </span>
                                    }
                                    else if (activity.ActivityType == "Role")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Role
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @activity.ActivityType
                                        </span>
                                    }
                                </td>

                                <td>
                                    @activity.CreatedAt.ToString(
                                        "dd MMM yyyy, hh:mm tt")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    No recent activity.
                </div>
            }

        </div>

    </div>

</div>