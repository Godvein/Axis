@model IEnumerable<Axis.Models.ViewModels.RoleViewModel>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Role Management</h2>
            <p class="text-muted mb-0">
                Manage roles and access levels within the system.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateRole"
           class="btn btn-primary">
            + Create Role
        </a>

    </div>

    <!-- Summary -->
    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <h6 class="text-muted mb-1">Total Roles</h6>
                            <h2 class="mb-0 text-primary">
                                @(Model?.Count() ?? 0)
                            </h2>
                        </div>

                        <div class="fs-1 text-primary">
                            🔐
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Roles -->
    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">System Roles</h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th width="100">ID</th>
                            <th>Role Name</th>
                            <th width="180">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>

                                    <td>
                                        <span class="text-muted">
                                            #@role.RoleId
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">

                                            <div class="me-3">
                                                <span class="badge bg-primary rounded-circle p-2">
                                                    👤
                                                </span>
                                            </div>

                                            <strong>
                                                @role.RoleName
                                            </strong>

                                        </div>
                                    </td>

                                    <td>

                                        <a asp-controller="Admin"
                                           asp-action="EditRole"
                                           asp-route-id="@role.RoleId"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="Admin"
                                           asp-action="DeleteRole"
                                           asp-route-id="@role.RoleId"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3"
                                    class="text-center text-muted py-5">

                                    <div class="fs-1 mb-2">
                                        🔐
                                    </div>

                                    <strong>No roles found</strong>

                                    <div>
                                        Create a role to get started.
                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>