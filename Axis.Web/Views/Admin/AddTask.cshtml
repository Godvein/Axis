@model Axis.Models.ViewModels.CreateTaskViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Task";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-success text-white">
            <h3 class="mb-0">Create New Task</h3>
        </div>

        <div class="card-body">

            <form asp-action="AddTask"
                  asp-controller="Admin"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Left Side -->

                    <div class="col-lg-8">

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="Enter task title..." />
                            <span asp-validation-for="Title"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label"></label>

                            <textarea asp-for="Description"
                                      rows="10"
                                      class="form-control"
                                      placeholder="Describe the task..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Right Side -->

                    <div class="col-lg-4">

                        <div class="card bg-light">

                            <div class="card-header">
                                Task Information
                            </div>

                            <div class="card-body">

                                <div class="mb-3">

                                    <label asp-for="Priority"
                                           class="form-label"></label>

                                    <select asp-for="Priority"
                                            class="form-select">

                                        <option value="">-- Select Priority --</option>
                                        <option value="Low">Low</option>
                                        <option value="Medium">Medium</option>
                                        <option value="High">High</option>

                                    </select>

                                    <span asp-validation-for="Priority"
                                          class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="Status"
                                           class="form-label"></label>

                                    <select asp-for="Status"
                                            class="form-select">

                                        <option value="Pending">Pending</option>
                                        <option value="In Progress">In Progress</option>
                                        <option value="Completed">Completed</option>

                                    </select>

                                    <span asp-validation-for="Status"
                                          class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="AssignedTo"
                                           class="form-label"></label>

                                    <select asp-for="AssignedTo"
                                            asp-items="@(new SelectList(Model.Users, "UserId", "FullName"))"
                                            class="form-select">

                                        <option value="">-- Assign User --</option>

                                    </select>

                                    <span asp-validation-for="AssignedTo"
                                          class="text-danger"></span>

                                </div>

                                <div class="mb-3">

                                    <label asp-for="DueDate"
                                           class="form-label"></label>

                                    <input asp-for="DueDate"
                                           type="date"
                                           class="form-control" />

                                    <span asp-validation-for="DueDate"
                                          class="text-danger"></span>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <hr />

                <button type="submit"
                        class="btn btn-success">
                    Create Task
                </button>

                <a asp-action="ManageTasks"
                   asp-controller="Admin"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
