```cshtml
@model Axis.Models.ViewModels.UserDashboardViewModel

@{
    ViewData["Title"] = "User Dashboard";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>Welcome 👋</h2>
        <p class="text-muted">Here's a summary of your work.</p>
    </div>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Assigned Tasks</h5>
                    <h2 class="text-primary">@Model.AssignedTasksCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Completed</h5>
                    <h2 class="text-success">@Model.CompletedTasksCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Pending</h5>
                    <h2 class="text-warning">@Model.PendingTasksCount</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">

            <h5 class="mb-0">My Tasks</h5>

            <a asp-controller="User"
               asp-action="Tasks"
               class="btn btn-sm btn-outline-primary">
                View All →
            </a>

        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Task</th>
                        <th>Priority</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th width="120">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Tasks.Any())
                    {
                        @foreach (var task in Model.Tasks.Take(5))
                        {
                            <tr>

                                <td>@task.Title</td>

                                <td>

                                    @if (task.Priority == "High")
                                    {
                                        <span class="badge bg-danger">High</span>
                                    }
                                    else if (task.Priority == "Medium")
                                    {
                                        <span class="badge bg-warning text-dark">Medium</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Low</span>
                                    }

                                </td>

                                <td>@task.DueDate.ToString("dd MMM yyyy")</td>

                                <td>

                                    @if (task.Status == "Pending")
                                    {
                                        <span class="badge bg-secondary">Pending</span>
                                    }
                                    else if (task.Status == "In Progress")
                                    {
                                        <span class="badge bg-warning text-dark">In Progress</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }

                                </td>

                                <td>

                                    <a asp-controller="User"
                                       asp-action="TaskDetails"
                                       asp-route-id="@task.TaskId"
                                       class="btn btn-sm btn-outline-info">
                                        View
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                You don't have any assigned tasks.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
```
