@model List<Axis.Models.ViewModels.TaskListViewModel>

@{
    ViewData["Title"] = "Manage Tasks";
}

<div class="container mt-4">

    <div class="card shadow border-0">

        <div class="card-header bg-success text-white">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h3 class="mb-0">Task Management</h3>
                    <small>Manage, assign and monitor tasks</small>
                </div>

                <a asp-action="CreateTask"
                   asp-controller="Admin"
                   class="btn btn-light">
                    + New Task
                </a>

            </div>

        </div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-4">
                    <input type="text"
                           class="form-control"
                           placeholder="Search task title..." />
                </div>

                <div class="col-md-2">
                    <select class="form-select">
                        <option>All Status</option>
                        <option>Pending</option>
                        <option>In Progress</option>
                        <option>Completed</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <select class="form-select">
                        <option>All Priority</option>
                        <option>High</option>
                        <option>Medium</option>
                        <option>Low</option>
                    </select>
                </div>

                <div class="col-md-4 text-end">
                    <button class="btn btn-success">
                        Search
                    </button>
                </div>

            </div>

            <table class="table table-hover align-middle">

                <thead class="table-success">

                    <tr>
                        <th>#</th>
                        <th>Task</th>
                        <th>Assigned To</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due Date</th>
                        <th>Completed</th>
                        <th width="220">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var task in Model)
                    {
                        <tr>

                            <td>@task.TaskId</td>

                            <td>
                                <strong>@task.Title</strong>
                            </td>

                            <td>@task.AssignedToName</td>

                            <td>

                                @if (task.Priority == "High")
                                {
                                    <span class="badge bg-danger">
                                        High
                                    </span>
                                }
                                else if (task.Priority == "Medium")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Low
                                    </span>
                                }

                            </td>

                            <td>

                                @if (task.Status == "Pending")
                                {
                                    <span class="badge bg-secondary">
                                        Pending
                                    </span>
                                }
                                else if (task.Status == "In Progress")
                                {
                                    <span class="badge bg-primary">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Completed
                                    </span>
                                }

                            </td>

                            <td>
                                @task.DueDate.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                @if (task.Completed)
                                {
                                    <span class="text-success fw-bold">
                                        ✔
                                    </span>
                                }
                                else
                                {
                                    <span class="text-danger fw-bold">
                                        ✘
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="EditTask"
                                   asp-route-id="@task.TaskId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="TaskDetails"
                                   asp-route-id="@task.TaskId"
                                   class="btn btn-sm btn-info text-white">
                                    View
                                </a>

                                <a asp-action="DeleteTask"
                                   asp-route-id="@task.TaskId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
